{
    "name": "snipcart-craft-plugin",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:css && npm run build:js",
        "build:css": "vite build --mode css",
        "build:js": "npm run build:snipcart && npm run build:overview && npm run build:orders-widget && npm run build:field-product-details && npm run build:settings-discount && npm run build:settings-plugin && npm run build:kit",
        "build:snipcart": "vite build --mode snipcart",
        "build:overview": "vite build --mode overview",
        "build:orders-widget": "vite build --mode OrdersWidget",
        "build:field-product-details": "vite build --mode field-product-details",
        "build:settings-discount": "vite build --mode settings-discount",
        "build:settings-plugin": "vite build --mode settings-plugin",
        "build:kit": "vite build --mode kit",
        "lint": "eslint src/web/assets/cp/src vite.config.mjs eslint.config.mjs"
    },
    "dependencies": {
        "@verbb/plugin-kit-web": "file:../../../plugin-kit/plugin-kit/plugin-kit-web",
        "apexcharts": "3.42.0",
        "clipboard": "^2.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "vite": "^8.3.5"
    },
